# docker-compose/.env.example — copie para .env e ajuste se necessário.
# Todos os valores abaixo são os defaults usados pelo compose (variáveis com
# fallback ${VAR:-default}); este arquivo serve de documentação/override.

# Tag das imagens GHCR (profile ghcr)
IMAGE_TAG=latest

# Porta exposta do authorization-service no host
AUTHORIZATION_PORT=3000

# Prefixo/nomes dos recursos no LocalStack — manter alinhado com o Terraform
QUEUE_PREFIX=finance-platform
AUTHORIZATION_TABLE=finance-platform-authorization
CHECKPOINT_TABLE=finance-platform-authorization-checkpoint
ACCOUNTING_ENTRIES_TABLE=finance-platform-accounting-entries
CONSUMER_IDEMPOTENCY_TABLE=finance-platform-consumer-idempotency
